<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lrgenius.server</string>

    <!-- Start the named launcher directly: macOS uses the executable name
         for an unsigned background item. The launcher handles log-directory
         fallback and execs the server so KeepAlive still watches its PID. -->

    <key>ProgramArguments</key>
    <array>
        <string>/Applications/LrGeniusAI/Server/LrGeniusAI</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
