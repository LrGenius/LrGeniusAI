{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-edited-file.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bash server/scripts/lint_format.sh)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(luacheck *)",
      "Bash(stylua *)",
      "Bash(busted *)",
      "Bash(python sync_translations.py)",
      "Bash(python3 scripts/check_translations.py)"
    ]
  }
}
